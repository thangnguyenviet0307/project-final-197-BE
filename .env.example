NODE_ENV=
PORT=

# MongoDB Atlas Connection
MONGODB_URI=
# Required in production: frontend origins, comma-separated, without trailing slashes.
# Example: https://your-frontend.example.com
FRONTEND_ORIGINS=
# Password for Faker seed accounts (at least 12 characters).
SEED_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=

BOOTSTRAP_SECRET=

# Email delivery through Brevo SMTP. Never commit actual credentials.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# A sender address verified in Brevo.
SMTP_FROM=
# Optional Brevo API key: uses HTTPS instead of SMTP when configured.
# Recommended for hosting that blocks outbound SMTP. This is NOT an SMTP key.
BREVO_API_KEY=
# Independent random secret of at least 32 bytes for OTP/reset token HMAC.
OTP_SECRET=

# Server-side product image storage (never use VITE_ prefixes for these credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=project-final/products
CLOUDINARY_BRAND_FOLDER=project-final/brands
CLOUDINARY_CATEGORY_FOLDER=project-final/categories
CLOUDINARY_WARRANTY_FOLDER=project-final/warranty

# Gemini API: use a Google AI Studio Free Tier project; vector search is optional.
AI_ENABLED=false
GEMINI_API_KEY=
AI_CHAT_MAX_OUTPUT_TOKENS=2048
AI_INTENT_MAX_OUTPUT_TOKENS=1536
AI_REASONING_EFFORT=low
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_VECTOR_INDEX=
AI_INDEX_ENABLED=false
AI_RISK_ENABLED=false

# Automatic chat routing. API keys enable providers with built-in default models.
# Edit model names below. Separate multiple models with commas, in priority order.
AI_PROVIDER_ORDER=gemini,groq,openrouter,cloudflare
GEMINI_CHAT_MODELS=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_CHAT_MODELS=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODELS=openrouter/free
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# Choose a Workers Free eligible model in your account.
CLOUDFLARE_CHAT_MODELS=@cf/meta/llama-3.1-8b-instruct

# Optional non-secret stable project/account labels keep cooldowns/counters across key rotation.
GEMINI_QUOTA_GROUP=
GROQ_QUOTA_GROUP=
OPENROUTER_QUOTA_GROUP=
CLOUDFLARE_QUOTA_GROUP=
# Emergency kill switch overrides database settings; requires server restart.
AI_FORCE_DISABLED=false
