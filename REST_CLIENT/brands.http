
# Detail/update/delete: set BRAND_ID in REST_CLIENT/.env to the record you choose from Get All.
@baseUrl = http://127.0.0.1:5001/api/v1/brands
@brandId = __BRAND_ID__

### 1. GET ALL BRANDS
GET {{baseUrl}}
x-rest-client-auth: primary
Authorization: Bearer {{$dotenv ACCESS_TOKEN}}

### 2. CREATE BRAND
POST {{baseUrl}}
x-rest-client-auth: primary
Authorization: Bearer {{$dotenv ACCESS_TOKEN}}
Content-Type: application/json

{
  "name": "Nike",
  "description": "Thuong hieu the thao"
}

### 3. TEST VALIDATION - NAME RONG
POST {{baseUrl}}
x-rest-client-auth: primary
Authorization: Bearer {{$dotenv ACCESS_TOKEN}}
Content-Type: application/json

{
  "name": "",
  "description": "Test validation"
}

### 4. TEST VALIDATION - THIEU NAME
POST {{baseUrl}}
x-rest-client-auth: primary
Authorization: Bearer {{$dotenv ACCESS_TOKEN}}
Content-Type: application/json

{
  "description": "Test validation"
}

### GET BRAND BY ID
GET {{baseUrl}}/{{brandId}}
x-rest-client-auth: primary
Authorization: Bearer {{$dotenv ACCESS_TOKEN}}

### 6. UPDATE BRAND
PUT {{baseUrl}}/{{brandId}}
x-rest-client-auth: primary
Authorization: Bearer {{$dotenv ACCESS_TOKEN}}
Content-Type: application/json

{
  "name": "Nike Updated",
  "description": "Thuong hieu da cap nhat"
}

### 7. DELETE BRAND
DELETE {{baseUrl}}/{{brandId}}
x-rest-client-auth: primary
Authorization: Bearer {{$dotenv ACCESS_TOKEN}}
