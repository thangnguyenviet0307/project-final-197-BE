# ==========================================
# 0.ĐĂNG NHẬP LẤY TOKEN
# ==========================================
### Đăng nhập tài khoản Admin 
POST {{baseUrl}}/login
Content-Type: application/json

{
  "email": "superadmin23@gmail.com",
  "password": "AdminPassword123"
}

# ==========================================
# CÁC API QUẢN LÝ USER (Yêu cầu Token & Phân quyền)
# ==========================================

### 1. Tạo một tài khoản Admin mới để test (Yêu cầu quyền Admin)
POST {{baseUrl}}
Content-Type: application/json
Authorization: {{adminToken}}

{
  "fullName": "Super Admin",
  "email": "superadmin23@gmail.com",
  "password": "AdminPassword123",
  "role": "admin"
}

### 2. Lấy danh sách tất cả users (Admin hoặc Staff đều xem được)
GET {{baseUrl}}
Authorization: {{adminToken}}

### 3. Lấy chi tiết user theo ID 
GET {{baseUrl}}/{{userId}}
Authorization: {{adminToken}}

### 4. Cập nhật thông tin user theo ID (CHỈ ADMIN)
PATCH {{baseUrl}}/{{userId}}
Content-Type: application/json
Authorization: {{adminToken}}

{
  "fullName": "ronaldo Updated"
}

### 5. Xóa user theo ID (CHỈ ADMIN)
DELETE {{baseUrl}}/{{userId}}
Authorization: {{adminToken}}


# ==========================================
# TEST PHÂN QUYỀN CHO TÀI KHOẢN STAFF
# ==========================================

### 6. Staff thử xem danh sách users (ĐƯỢC PHÉP - Trả về 200)
GET {{baseUrl}}
Authorization: {{staffToken}}

### 7. Staff thử tạo mới user (BỊ CHẶN - Phải trả về lỗi 403 Forbidden)
POST {{baseUrl}}
Content-Type: application/json
Authorization: {{staffToken}}

{
  "fullName": "Staff Hacker",
  "email": "hacker3@example.com",
  "password": "Password123",
  "role": "admin"
}

### 8. Staff thử xóa user (BỊ CHẶN - Phải trả về lỗi 403 Forbidden)
DELETE {{baseUrl}}/{{userId}}
Authorization: {{staffToken}}