# Select PRODUCT_ID/VARIANT_ID in REST_CLIENT/.env or create a test product first.
@baseUrl = http://127.0.0.1:5001/api/v1/products
@productId = __PRODUCT_ID__
@variantId = __VARIANT_ID__
@productIdToUpdate = __PRODUCT_ID__
@productIdToDelete = __PRODUCT_ID__
@categoryId = __CATEGORY_ID__
@brandId = __BRAND_ID__

### Lấy danh sách sản phẩm
GET {{baseUrl}}
x-rest-client-auth: primary
Authorization: Bearer {{$dotenv ACCESS_TOKEN}}
Accept: application/json

### Tạo sản phẩm mới
POST {{baseUrl}}
x-rest-client-auth: primary
Authorization: Bearer {{$dotenv ACCESS_TOKEN}}
Content-Type: application/json

{
  "product_name": "iPhone 14 Pro",
  "price": 29990000,
  "discount": 10,
  "category": "{{categoryId}}",
  "brand": "{{brandId}}",
  "description": "Điện thoại cao cấp",
  "model_year": 2023,
  "slug": "iphone-14-pro",
  "thumbnail": "https://example.com/iphone14pro.jpg",
  "variants": [
    {
      "sku": "IP14P-128-BLK",
      "variant_name": "Black - 128GB",
      "color": "Black",
      "size": "128GB",
      "price": 29990000,
      "stock": 20,
      "image": "https://example.com/iphone14pro-black.jpg",
      "images": [
        "https://example.com/iphone14pro-black.jpg",
        "https://example.com/iphone14pro-black-2.jpg"
      ],
      "attributes": {
        "storage": "128GB",
        "color": "Black"
      }
    },
    {
      "sku": "IP14P-256-BLK",
      "variant_name": "Black - 256GB",
      "color": "Black",
      "size": "256GB",
      "price": 33990000,
      "stock": 12,
      "image": "https://example.com/iphone14pro-black-256.jpg",
      "attributes": {
        "storage": "256GB",
        "color": "Black"
      }
    }
  ]
}

### Lấy sản phẩm theo id
GET {{baseUrl}}/{{productId}}
x-rest-client-auth: primary
Authorization: Bearer {{$dotenv ACCESS_TOKEN}}
Accept: application/json

### Tìm sản phẩm theo SKU
GET {{baseUrl}}/sku/IP14P-128-BLK
x-rest-client-auth: primary
Authorization: Bearer {{$dotenv ACCESS_TOKEN}}
Accept: application/json

### Lọc sản phẩm theo color / size
GET {{baseUrl}}?color=Black&size=128GB
x-rest-client-auth: primary
Authorization: Bearer {{$dotenv ACCESS_TOKEN}}
Accept: application/json

### Lấy variant theo product id và variant id
GET {{baseUrl}}/{{productId}}/variants/{{variantId}}
x-rest-client-auth: primary
Authorization: Bearer {{$dotenv ACCESS_TOKEN}}
Accept: application/json

### Cập nhật sản phẩm
PUT {{baseUrl}}/{{productIdToUpdate}}
x-rest-client-auth: primary
Authorization: Bearer {{$dotenv ACCESS_TOKEN}}
Content-Type: application/json

{
  "description": "Updated product description",
  "discount": 5
}

### Xoá sản phẩm
DELETE {{baseUrl}}/{{productIdToDelete}}
x-rest-client-auth: primary
Authorization: Bearer {{$dotenv ACCESS_TOKEN}}
Accept: application/json
