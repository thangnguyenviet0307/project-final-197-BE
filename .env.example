NODE_ENV=
PORT=

# MongoDB Atlas Connection
MONGODB_URI=
# Required in production: frontend origins, comma-separated, without trailing slashes.
# Example: https://your-frontend.example.com
FRONTEND_ORIGINS=
# Password for Faker seed accounts (at least 12 characters).
SEED_PASSWORD=
JWT_SECRET=
JWT_REFRESH_SECRET=

BOOTSTRAP_SECRET=

# Email delivery through Brevo SMTP. Never commit actual credentials.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# A sender address verified in Brevo.
SMTP_FROM=
# Independent random secret of at least 32 bytes for OTP/reset token HMAC.
OTP_SECRET=

# Server-side product image storage (never use VITE_ prefixes for these credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCT_FOLDER=project-final/products
CLOUDINARY_BRAND_FOLDER=project-final/brands
CLOUDINARY_CATEGORY_FOLDER=project-final/categories
CLOUDINARY_WARRANTY_FOLDER=project-final/warranty
