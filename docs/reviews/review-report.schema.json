{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-final-197:review-report:1.0.0",
  "title": "Reusable technical review report 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "templateVersion",
    "reportMeta",
    "overview",
    "coverage",
    "findings",
    "featureMatrix",
    "missingFeatures",
    "actionPlan",
    "manualTests",
    "checks",
    "topPriorities"
  ],
  "properties": {
    "templateVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "reportMeta": {
      "$ref": "#/$defs/reportMeta"
    },
    "overview": {
      "$ref": "#/$defs/overview"
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "featureMatrix": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/featureMatrix"
      }
    },
    "missingFeatures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/missingFeature"
      }
    },
    "actionPlan": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/actionPlan"
      }
    },
    "manualTests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/manualTest"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "topPriorities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topPriority"
      },
      "minItems": 5,
      "maxItems": 5
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "line",
        "symbol",
        "description"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "branch",
        "commit",
        "dirty",
        "notes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "reportMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectName",
        "reviewedAt",
        "reviewer",
        "isExample",
        "repositories",
        "branch",
        "commit",
        "scope",
        "limitations"
      ],
      "properties": {
        "projectName": {
          "type": "string",
          "minLength": 1
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "isExample": {
          "type": "boolean"
        },
        "repositories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repository"
          }
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "technology",
        "evidence"
      ],
      "properties": {
        "layer": {
          "type": "string",
          "enum": [
            "BE",
            "FE",
            "DB",
            "Integration",
            "Deployment"
          ]
        },
        "technology": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "demoReadiness",
        "strengths",
        "blockers",
        "stack"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "demoReadiness": {
          "type": "string",
          "minLength": 1
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stack": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stack"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module",
        "layer",
        "status",
        "paths",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "minLength": 1
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "string",
          "enum": [
            "BE",
            "FE",
            "DB",
            "Integration",
            "Deployment"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "reviewed",
            "sampled",
            "not_reviewed"
          ]
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "severity",
        "verificationStatus",
        "module",
        "layer",
        "evidence",
        "preconditions",
        "reproductionSteps",
        "expectedBehavior",
        "actualBehavior",
        "impact",
        "recommendation",
        "verificationMethod"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "verificationStatus": {
          "type": "string",
          "enum": [
            "confirmed",
            "risk",
            "not_found",
            "improvement"
          ]
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "type": "string",
          "enum": [
            "BE",
            "FE",
            "DB",
            "Integration",
            "Deployment"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reproductionSteps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expectedBehavior": {
          "type": "string",
          "minLength": 1
        },
        "actualBehavior": {
          "type": "string",
          "minLength": 1
        },
        "impact": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        },
        "verificationMethod": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "featureMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "module",
        "fe",
        "be",
        "database",
        "integration",
        "status",
        "remainingIssues",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "minLength": 1
        },
        "module": {
          "type": "string",
          "minLength": 1
        },
        "fe": {
          "type": "string",
          "minLength": 1
        },
        "be": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "integration": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "implemented",
            "partial",
            "not_found",
            "unverified"
          ]
        },
        "remainingIssues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "missingFeature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "priority",
        "currentState",
        "evidence",
        "rationale",
        "minimumScope",
        "affectedLayers",
        "difficulty",
        "estimatedEffort",
        "assumptions",
        "dependencies",
        "acceptanceCriteria"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "core",
            "recommended",
            "later"
          ]
        },
        "currentState": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "minimumScope": {
          "type": "string",
          "minLength": 1
        },
        "affectedLayers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "BE",
              "FE",
              "DB",
              "Integration",
              "Deployment"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "estimatedEffort": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "actionPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "priority",
        "timing",
        "dependsOn",
        "scope",
        "deliverables",
        "acceptanceCriteria"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "timing": {
          "type": "string",
          "minLength": 1
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "manualTest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actor",
        "scenario",
        "steps",
        "expectedBehavior",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "minLength": 1
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expectedBehavior": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "not_run",
            "passed",
            "failed"
          ]
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repository",
        "command",
        "status",
        "summary",
        "scope",
        "executedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "passed",
            "passed_with_warnings",
            "failed",
            "not_run",
            "historical"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "executedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "topPriority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "rationale",
        "findingIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "findingIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  }
}
